# Settings for the search-bot research engine, used by tools/deeper. Copy to a private file
# outside the repository (for example ~/.config/epis/sb.env), fill in, and `source` it.
# Never commit a filled-in copy.

export SEARCHBOT_DIR="$HOME/search-bot"           # your checkout of github.com/Rhadadi/search-bot, branch epis-evidence
export SEARCHBOT_EMBED_URL=http://127.0.0.1:8082/v1  # tools/deeper/lexical_embed_server.py (or search-bot's scripts/embed_server.py)
export SEARCHBOT_QUERY_INSTRUCT="Represent this sentence for searching relevant passages: "
export SEARCHBOT_MAX_CHUNKS=4000                     # whole books, not just their first 40 passages
export SEARCHBOT_MAX_PAGES=900
export SEARCHBOT_USER_AGENT="search-bot/1.0 (open-access research for epis.duckdns.org scholarly companions; +https://github.com/raaaas/search-bot)"

# Optional: OpenAlex API key, only for {"openalex": DOI} targets. Get your own at https://openalex.org
# and set it in your shell or the agent's secret store. Never write the value into a file in this repository.
# export SEARCHBOT_OPENALEX_KEY=...
